<?xml version="1.0" encoding="utf-8"?>
<!-- 직업·전직 고르기 버튼 — 고르면 금색으로 물든다 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_15" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC1A1D25" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/bronze_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0E1117" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/bronze" />
        </shape>
    </item>
</selector>
