<?xml version="1.0" encoding="utf-8"?>
<!-- 트리 조작 버튼 — 금동 테두리의 사각 버튼 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_15" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/gold_40" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC12151C" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/bronze_soft" />
        </shape>
    </item>
</selector>
