<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PoE2DB" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/on_gold</item>
        <item name="colorPrimaryContainer">@color/surface_high</item>
        <item name="colorOnPrimaryContainer">@color/gold_soft</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/on_gold</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="chipStyle">@style/Widget.PoE2DB.Chip</item>
    </style>

    <style name="Widget.PoE2DB.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.PoE2DB.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/gold_15</item>
    </style>

    <style name="MarketDetailSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

</resources>
