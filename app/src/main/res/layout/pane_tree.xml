<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 상단 툴바: 무엇을 볼지(패시브·아틀라스)와 검색·직업·스탯 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_tree_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/treeModeGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:chipSpacingHorizontal="6dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPassiveTree"
                    style="@style/Widget.PoE2DB.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/tree_passive" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAtlasTree"
                    style="@style/Widget.PoE2DB.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tree_atlas" />
            </com.google.android.material.chip.ChipGroup>

            <ImageButton
                android:id="@+id/btnTreeSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tree_search"
                android:padding="9dp"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btnTreeStats"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tree_stats"
                android:padding="9dp"
                android:src="@drawable/ic_info" />

            <ImageButton
                android:id="@+id/btnTreeFit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tree_fit"
                android:padding="9dp"
                android:src="@drawable/ic_tree_fit" />

            <ImageButton
                android:id="@+id/btnTreeRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_refresh"
                android:padding="9dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- 찍은 포인트: 패시브 · 전직 ( · 정신력) -->
        <TextView
            android:id="@+id/tvTreePoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0A0D12"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 직업·전직 고르기 (필요할 때만 편다) -->
        <HorizontalScrollView
            android:id="@+id/treeClassScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B30A0D12"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/treeClassRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 앱이 직접 그리는 트리 (웹뷰 없음) -->
            <com.sunuhwi.poe2dbkr.TreeCanvasView
                android:id="@+id/treeCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/treeCanvasBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#D90A0D12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTreeCanvasInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/treeNodeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="64dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tree_panel"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTreeNodeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/gold_soft"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnTreeNodeClose"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/tree_node_close"
                        android:padding="6dp"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTreeNodeKind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/bronze_soft"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTreeNodeStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTreeNodeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tree_node_hint"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
